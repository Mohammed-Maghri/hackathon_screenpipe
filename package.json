{
  "name": "ghost-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Ghost \u2014 your work, understood.",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "postinstall": "install-electron",
    "test": "node scripts/check-core.mjs",
    "test:electron": "npm run build && node scripts/check-reliability.mjs && node scripts/check-failures.mjs",
    "test:resilience": "npm run build && node scripts/check-resilience.mjs",
    "test:processing": "node scripts/check-processing.mjs",
    "test:processing:electron": "npm run build && node scripts/check-processing-electron.mjs && node scripts/check-processing-ui.mjs",
    "test:template-drafts": "npm run build && npm --prefix backend run build && node scripts/check-template-drafts.mjs",
    "test:browser-settings": "npm run build && node scripts/check-browser-settings.mjs",
    "test:runtime-logic": "npm run build && node scripts/check-runtime-logic.mjs",
    "test:runtime-logic:electron": "npm run build && node scripts/check-runtime-logic-electron.mjs",
    "build:web": "vite build --config vite.web.config.ts --outDir ../../dist/web --emptyOutDir",
    "screenpipe:install": "node scripts/install-screenpipe-discovery.mjs",
    "test:blue-flow": "npm run build && node scripts/check-blue-flow.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@xyflow/react": "^12.12.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
