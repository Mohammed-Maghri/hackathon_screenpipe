# Root Docker Compose settings. This is separate from backend/.env.
# Defaults are only for a local hackathon environment.
POSTGRES_USER=ghost
POSTGRES_PASSWORD=ghost_dev
POSTGRES_DB=ghost
POSTGRES_PORT=5433
BACKEND_PORT=3001
FRONTEND_PORT=8080
FIXTURES_PORT=3100
# Development mode enables the explicitly simulated discovery endpoints.
GHOST_API_ENV=development
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
# Host Electron settings (not forwarded to backend containers).
# Screenpipe must be open with captured activity and a configured AI preset.
SCREENPIPE_LOCAL_API_URL=http://localhost:3030
SCREENPIPE_LOCAL_API_KEY=
SCREENPIPE_AI_PRESET=default
# Optional: final-answer directory if Screenpipe uses a non-default Pipe location.
# SCREENPIPE_DISCOVERY_OUTPUT_DIR=/absolute/path/to/ghost-workflow-discovery/output
